# Optional API keys - ThreatTriage works without them (IP reputation via ip-api,
# ISC SANS, and GreyNoise), but keys unlock hash/domain/URL coverage and more sources.
# All are free to obtain. Copy to .env (or set as environment variables).

ABUSEIPDB_API_KEY=     # https://www.abuseipdb.com/  (IP reputation)
VT_API_KEY=            # https://www.virustotal.com/ (IP/hash/domain/URL)
OTX_API_KEY=           # https://otx.alienvault.com/ (all indicator types)
ABUSE_CH_API_KEY=      # https://auth.abuse.ch/      (ThreatFox / URLhaus)
GREYNOISE_API_KEY=     # https://www.greynoise.io/   (optional, raises limits)
